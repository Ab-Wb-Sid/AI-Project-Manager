# Copy to .env and fill in real values locally. Never commit .env.

# --- Backend (server only) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
SESSION_SECRET="paste-a-random-string-of-at-least-32-characters"
LLM_PROVIDER="anthropic"
LLM_API_KEY="your-api-key"
LLM_MODEL="your-model-name"
LLM_TIMEOUT_MS="60000"

# --- Frontend (safe to expose; no secrets here) ---
# Show the click-to-fill demo accounts box on the login screen. Set to "false" outside demos.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"
# Development only: run the UI against an in-browser mock of the API contract when the backend
# isn't available. Leave "false" for the real app, which always calls the AI through the server.
NEXT_PUBLIC_USE_MOCK_API="false"
